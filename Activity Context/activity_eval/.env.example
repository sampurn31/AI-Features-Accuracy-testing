# Copy to .env and fill in. .env is gitignored — never commit it.
#
# TWO credentials per environment, and they are not interchangeable:
#   *_API_KEY            public API — jobs, candidates, notes, call logs
#   *_EMAIL / *_PASSWORD login, exchanged for the token the AI Matching endpoints need
#
# ai2 and dev are two deployments over ONE database. The ai2 public-API host often has no
# DNS, so seeding and reads go through dev.

AI2_API_KEY=
AI2_EMAIL=
AI2_PASSWORD=

DEV_API_KEY=
DEV_EMAIL=
DEV_PASSWORD=

# Judge. Omit if ANTHROPIC_API_KEY is already exported or an `ant` profile is active.
ANTHROPIC_API_KEY=
