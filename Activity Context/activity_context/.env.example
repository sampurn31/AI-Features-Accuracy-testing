# Copy to .env and fill in. .env is gitignored — never commit it.
#
# TWO credentials per environment, and they are not interchangeable:
#   *_API_KEY            public API — jobs, candidates, notes, call logs
#   *_EMAIL / *_PASSWORD login, exchanged for the token AI Matching needs
#   *_LABEL              optional display name used in reports
#
# The two deployments share ONE database. Seed once.

ATS9_API_KEY=
ATS9_EMAIL=
ATS9_PASSWORD=
ATS9_LABEL=with activity context

DEV_API_KEY=
DEV_EMAIL=
DEV_PASSWORD=
DEV_LABEL=without activity context

ANTHROPIC_API_KEY=
