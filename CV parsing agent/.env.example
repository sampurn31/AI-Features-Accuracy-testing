# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Keys ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Track A — Albatross baseline parser ──────────────────────────────────────
TRACK_A_BASE_URL=
TRACK_A_EMAIL=
TRACK_A_PASSWORD=

# ── Track B / SS — Albatross AI parser ───────────────────────────────────────
TRACK_B_BASE_URL=
TRACK_B_EMAIL=
TRACK_B_PASSWORD=

# ── Comparator — Sovren vs InHouse comparison ─────────────────────────────────
COMPARATOR_BASE_URL=
SOVREN_EMAIL=
SOVREN_PASSWORD=
INHOUSE_EMAIL=
INHOUSE_PASSWORD=

# ── Bulk parser ───────────────────────────────────────────────────────────────
BULK_BASE_URL=
BULK_EMAIL=
BULK_PASSWORD=

# ── Nested custom fields pipeline ────────────────────────────────────────────
NESTED_SS_EMAIL=
NESTED_SS_PASSWORD=

# ── Deep nested custom fields pipeline ───────────────────────────────────────
DEEP_NESTED_SS_EMAIL=
DEEP_NESTED_SS_PASSWORD=

# ── Multilingual — German / Spanish / Dutch ───────────────────────────────────
ML_SS_BASE_URL_TS2=
ML_SS_EMAIL=
ML_SS_PASSWORD=

# ── Multilingual — Hebrew ─────────────────────────────────────────────────────
ML_HEBREW_SS_BASE_URL=
ML_HEBREW_SS_EMAIL=
ML_HEBREW_SS_PASSWORD=

# ── Multilingual — Japanese ───────────────────────────────────────────────────
